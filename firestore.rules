rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to fetch user document safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifies admin role checking both role string and roles array
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == "Admin" || 
        ("roles" in getUserData() && "Admin" in getUserData().roles)
      );
    }

    // Verifies approved trainer checking both role string and roles array
    function isApprovedTrainer() {
      return isAuthenticated() && (
        (getUserData().role == "Trainer" && getUserData().isApproved == true) ||
        ("roles" in getUserData() && "Trainer" in getUserData().roles && getUserData().isApproved == true)
      );
    }

    // Helper: returns true if the update is changing any protected field
    function isChangingProtectedFields() {
      return (
        request.resource.data.role != resource.data.role ||
        request.resource.data.roles != resource.data.roles ||
        request.resource.data.isApproved != resource.data.isApproved ||
        request.resource.data.isActive != resource.data.isActive
      );
    }

    // 1. Users Collection
    //    - Anyone can read (authenticated).
    //    - Users can update their OWN profile (name, skills, etc.) but NOT role/roles/isApproved/isActive.
    //    - Only Admins can change role, roles, isApproved, isActive on ANY user.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (
        // Admin can update anything on anyone
        isAdmin() ||
        // Non-admin can only update their own doc AND must NOT touch protected fields
        (request.auth.uid == userId && !isChangingProtectedFields())
      );
      allow delete: if isAuthenticated() && isAdmin();
    }

    // 2. Courses Collection
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isApprovedTrainer() || isAdmin());
      
      match /feedback/{feedbackId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == feedbackId || isAdmin());
      }
    }

    // 3. Enrollments Collection
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || 
        isAdmin()
      );
    }

    // 4. Assessments & Submissions
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isApprovedTrainer() || isAdmin());
      
      match /submissions/{subId} {
        allow read: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          isApprovedTrainer() || 
          isAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && isAdmin();
      }
    }

    // 5. Trainer Library / Vault
    match /trainer_library/{fileId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isApprovedTrainer() || isAdmin());
    }

    // 6. Announcements Feed
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // 7. Support Tickets
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.submittedById == request.auth.uid || 
        isAdmin()
      );

      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && isAdmin();
      }
    }
  }
}
