rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to fetch user document safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifies admin role checking both role string and roles array
    function isAdmin() {
      return isAuthenticated() && (
        ("roles" in getUserData()) ? 
          ("Admin" in getUserData().roles) : 
          (getUserData().role == "Admin")
      );
    }

    // Verifies approved trainer checking both role string and roles array
    function isApprovedTrainer() {
      return isAuthenticated() && getUserData().isApproved == true && (
        ("roles" in getUserData()) ? 
          ("Trainer" in getUserData().roles) : 
          (getUserData().role == "Trainer")
      );
    }

    // Public sign-up can only create the two non-privileged account types.
    // Admin accounts must be provisioned by a trusted server/Admin SDK.
    function isValidSelfRegistration(userId) {
      return request.auth.uid == userId &&
        request.resource.data.id == userId &&
        request.resource.data.role in ["Trainee", "Trainer"] &&
        request.resource.data.roles == [request.resource.data.role] &&
        ((request.resource.data.role == "Trainee" &&
          request.resource.data.isApproved == true &&
          request.resource.data.isActive == true) ||
         (request.resource.data.role == "Trainer" &&
          request.resource.data.isApproved == false &&
          request.resource.data.isActive == false));
    }

    function isOwnProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "firstName", "lastName", "fullName", "avatarUrl", "qualifications",
        "skills", "interests", "workExperience", "certificates", "experienceYears",
        "subjectsHandled", "lastLoginAtUtc"
      ]);
    }

    // 1. Users Collection
    //    - Anyone can read (authenticated).
    //    - Users can update their OWN profile (name, skills, etc.) but NOT role/roles/isApproved/isActive.
    //    - Only Admins can change role, roles, isApproved, isActive on ANY user.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || isValidSelfRegistration(userId));
      allow update: if isAuthenticated() && (
        // Admin can update anything on anyone
        isAdmin() ||
        // Users may only edit their own profile fields, never identity or permissions.
        (request.auth.uid == userId && isOwnProfileUpdate())
      );
      allow delete: if isAuthenticated() && isAdmin();
    }

    // 2. Courses Collection
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isApprovedTrainer() || isAdmin());
      
      match /feedback/{feedbackId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == feedbackId || isAdmin());
      }
    }

    // 3. Enrollments Collection
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        (resource.data.studentId == request.auth.uid &&
          request.resource.data.studentId == resource.data.studentId &&
          request.resource.data.courseId == resource.data.courseId) || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || 
        isAdmin()
      );
    }

    // 4. Assessments & Submissions
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isApprovedTrainer() || isAdmin());
      
      match /submissions/{subId} {
        allow read: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          isApprovedTrainer() || 
          isAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && isAdmin();
      }
    }

    // 4a. Quizzes & Questions
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isApprovedTrainer() || isAdmin());

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (isApprovedTrainer() || isAdmin());
      }
    }

    // 4b. Assignments & submissions (used by the assignment manager and gradebook).
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isApprovedTrainer() || isAdmin());

      match /submissions/{submissionId} {
        allow read: if isAuthenticated() && (
          resource.data.studentId == request.auth.uid || isApprovedTrainer() || isAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (isApprovedTrainer() || isAdmin());
      }
    }

    // 4c. Department administration.
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // 5. Trainer Library / Vault
    match /trainer_library/{fileId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isApprovedTrainer() || isAdmin());
    }

    // 6. Announcements Feed
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // 7. Support Tickets
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.submittedById == request.auth.uid || 
        isAdmin()
      );

      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && isAdmin();
      }
    }
  }
}
